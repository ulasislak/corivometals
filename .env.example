# Public site URL. No trailing slash. Set this in Vercel before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — anon key is public. Service role stays on the server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. The from-address domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_NOTIFY_EMAIL=

# Salt for hashing IP addresses used only for rate limiting. Use a long random string.
RATE_LIMIT_SALT=

# Private quote inbox. Open /inbox/<this value>. Leave blank to keep the page closed.
# Use a long random string. Do not link this URL from the site.
QUOTE_INBOX_KEY=

# Optional analytics. The script loads only after the visitor accepts cookies.
# Example for Plausible: src https://plausible.io/js/script.js and domain getcorivo.com
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Legal identity. Leave blank until the company record is confirmed.
# The imprint shows "Not published yet" for anything unset. Do not invent these.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_COUNTRY=
NEXT_PUBLIC_COMPANY_REGISTER=
NEXT_PUBLIC_COMPANY_VAT=
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
